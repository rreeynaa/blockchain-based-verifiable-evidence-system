# Copy to .env (`cp .env.example .env`). NEVER commit .env.
# -------- Auth --------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-.env
JWT_EXPIRE_MINUTES=60
INVESTIGATOR_PASSWORD=investigator123
AUDITOR_PASSWORD=auditor123
ADMIN_PASSWORD=admin123

# -------- Database --------
POSTGRES_PASSWORD=bves_dev_password
# docker-compose overrides this with the postgres service. SQLite fallback for local runs:
DATABASE_URL=sqlite:///./bves.db

# -------- Chain (local Hardhat node only) --------
# This is Hardhat's PUBLIC well-known account #0 key. It guards nothing of value.
# Never reuse it (or any key from this file) on a real network.
SIGNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
RPC_URL=http://localhost:8545
DEPLOYMENT_FILE=shared/deployment.json

# -------- IPFS --------
IPFS_API_URL=http://localhost:5001

# -------- Encryption master key --------
# Leave MASTER_KEY_B64 empty to auto-generate a 32-byte key file (created chmod 600).
# Or: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
MASTER_KEY_B64=
MASTER_KEY_FILE=shared/master.key

# -------- Ingestor --------
INCOMING_DIR=incoming
BATCH_SIZE=4
BATCH_WINDOW_SECONDS=30
API_URL=http://localhost:8000
